<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build's copy of main/res/xml/shortcuts.xml, for its .debug package. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="start" android:enabled="true" android:icon="@drawable/ic_shortcut_start"
        android:shortcutShortLabel="@string/shortcut_start" android:shortcutLongLabel="@string/shortcut_start_long">
        <intent android:action="com.spindletrack.android.START_TIMER" android:targetPackage="com.spindletrack.android.debug" android:targetClass="com.spindletrack.android.ShortcutActivity" />
    </shortcut>
    <shortcut android:shortcutId="stop" android:enabled="true" android:icon="@drawable/ic_shortcut_stop"
        android:shortcutShortLabel="@string/shortcut_stop" android:shortcutLongLabel="@string/shortcut_stop_long">
        <intent android:action="com.spindletrack.android.STOP_TIMER" android:targetPackage="com.spindletrack.android.debug" android:targetClass="com.spindletrack.android.ShortcutActivity" />
    </shortcut>
</shortcuts>
