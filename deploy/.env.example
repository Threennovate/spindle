# Settings for Spindle on your own server, read by docker-compose.yml. Copy this file to .env next to it and fill it
# in. docs/self-hosting.md explains each setting. Keep .env out of git: it holds secrets.
#
# Write values without quotes. A value with a $ in it needs $$ instead.

# --- Required ---------------------------------------------------------------------------------------------------

# The full public address people open Spindle at. Used in email links and for passkeys in the browser.
# To try it on this machine first: http://localhost:8080
App__BaseUrl=https://spindle.example.com

# The host name of that address, without https://. Separate several with ;
AllowedHosts=spindle.example.com

# The password of the database. Any long random string, e.g. from: openssl rand -hex 32
# It is set when the database is created the first time. Changing it here later doesn't change it in the database.
POSTGRES_PASSWORD=REPLACE_ME

# Signs sign-in tokens. At least 32 random characters, e.g. from: openssl rand -base64 48
# Changing it signs everyone out.
Auth__SigningKey=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# --- Who can sign up --------------------------------------------------------------------------------------------

# Anyone who can open the address can create an account, unless this is false. Then only people invited to a
# workspace can. Create your own account first, then turn it off.
# Auth__AllowRegistration=false

# The people who run this server. Once they have confirmed their email, they see every organization with its owner
# under Operator in the account menu, but nobody's tracked time.
# Operators__Emails__0=you@example.com
# Operators__Emails__1=someone-else@example.com

# --- Email ------------------------------------------------------------------------------------------------------

# For confirming email addresses, resetting passwords and invitations. Without these, nobody gets email and
# everything else works. Any SMTP server; docs/self-hosting.md has an example with Resend.
# Smtp__Host=smtp.example.com
# Smtp__Port=587
# StartTls on port 587, SslOnConnect on port 465, None only for a mail catcher.
# Smtp__Security=StartTls
# Smtp__UserName=
# Smtp__Password=
# Smtp__FromAddress=noreply@example.com
# Smtp__FromName=Spindle
# Where replies go, when nobody reads the sender address.
# Smtp__ReplyToAddress=hello@example.com

# To try it with the Mailpit in docker-compose.yml instead (docker compose --profile mailpit up -d):
# Smtp__Host=mailpit
# Smtp__Port=1025
# Smtp__Security=None

# --- Terms ------------------------------------------------------------------------------------------------------

# Terms of service and a privacy policy that new accounts must agree to. Leave them out and nobody is asked to agree
# to anything. TermsVersion is kept with each account that agrees; change it whenever the terms change.
# App__TermsUrl=https://example.com/terms
# App__PrivacyUrl=https://example.com/privacy
# App__TermsVersion=2026-10-01

# Where people get the source code of the version you run, linked in the web app. Change it if you run a modified
# version, as the AGPL asks.
# App__SourceUrl=https://github.com/Threennovate/spindle

# --- Docker -----------------------------------------------------------------------------------------------------

# Which image to run. latest is the newest release; a version such as 1.2.0 (or 1.2) stays on it until you change it.
# SPINDLE_IMAGE=ghcr.io/threennovate/spindle:latest

# Where the app listens on this machine. By default only this machine reaches it, for a reverse proxy in front.
# 8080 opens it to the network.
# SPINDLE_PORT=127.0.0.1:8080

# The address range of the Docker network. Change it only if Docker says it overlaps another network.
# SPINDLE_SUBNET=10.213.0.0/24
