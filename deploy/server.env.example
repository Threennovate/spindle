# Runtime variables for running the image without docker-compose.yml, e.g. on a platform that sets them itself, and
# the settings only Spindle Cloud uses. See docs/self-hosting.md. Not Docker build arguments.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__Default=Host=POSTGRES_HOST;Port=5432;Database=spindle;Username=spindle;Password=REPLACE_ME
Auth__SigningKey=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS
App__BaseUrl=https://spindle.example.com
# Include loopback hosts for a healthcheck from inside the container.
AllowedHosts=spindle.example.com;localhost;127.0.0.1
Database__MigrateOnStartup=true
App__DownloadsPath=/app/downloads
# Only invited people can create accounts, e.g. on a private server.
# Auth__AllowRegistration=false
# The people who run this server and see its organizations under Operator. Their emails must be confirmed.
# Operators__Emails__0=someone@example.com
# Use the actual network CIDR of the reverse proxy, not a guessed subnet.
# ReverseProxy__KnownNetworks__0=172.18.0.0/16
# "Continue with Google" and "Continue with Apple", with your own credentials; scripts/setup-sign-in.sh sets them up.
# The client secret and the private key are secrets. On one line, write the key's line breaks as \n.
# Auth__Google__ClientId=
# Auth__Google__ClientSecret=
# Auth__Apple__ServicesId=
# Auth__Apple__TeamId=
# Auth__Apple__KeyId=
# Auth__Apple__PrivateKey=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Any SMTP server; docs/self-hosting.md has an example with Resend.
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__Security=StartTls
Smtp__UserName=REPLACE_ME
Smtp__Password=REPLACE_ME
Smtp__FromAddress=noreply@example.com
# Where replies go, when nobody reads the sender address.
# Smtp__ReplyToAddress=hello@example.com
# Spindle Cloud only: trials and plans, and terms new accounts agree to. Leave them out on your own server.
# Subscriptions__Enabled=true
# Paying through Paddle (Spindle Cloud only). The API key and webhook secret are secrets; the rest is not.
# Subscriptions__Paddle__Environment=production
# Subscriptions__Paddle__ApiKey=
# Subscriptions__Paddle__ClientToken=
# Subscriptions__Paddle__WebhookSecret=
# Webhooks are taken only from Paddle's addresses (its /ips list), so behind a reverse proxy set
# ReverseProxy__KnownNetworks__0 above, or every webhook seems to come from the proxy and is refused. Off only for a
# tunnel while developing:
# Subscriptions__Paddle__CheckWebhookSources=false
# Price cohorts: new organizations join the current one and keep its prices for good. Cohorts are only ever added,
# each with its own two catalog prices; changing the current one changes the price for new organizations only.
# Names are lower case, digits and underscores (e.g. standard_2027), since they are part of the variable names.
# Subscriptions__CurrentPriceCohort=founding
# Subscriptions__Paddle__PriceCohorts__founding__MonthlyPriceId=
# Subscriptions__Paddle__PriceCohorts__founding__YearlyPriceId=
# Live Activity pushes to the iPhone app (Spindle Cloud only): the APNs key of the team that signs the app. The private
# key is the text of the .p8 file, a secret; on one line, write its line breaks as \n.
# Push__Apns__KeyId=
# Push__Apns__TeamId=
# Push__Apns__PrivateKey=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Push__Apns__BundleId=com.spindletrack.iphone
# App__TermsUrl=https://example.com/terms
# App__PrivacyUrl=https://example.com/privacy
# App__TermsVersion=2026-10-01
