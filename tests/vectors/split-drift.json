      "sessions": [
        { "id": "a", "repository": "atlas", "touches": ["2026-09-14 09:00", "2026-09-14 09:10", "2026-09-14 09:25", "2026-09-14 09:45"] },
        { "id": "b", "repository": "beacon", "touches": ["2026-09-14 09:05", "2026-09-14 09:15", "2026-09-14 09:35"] },
        { "id": "z", "repository": "zeta", "touches": ["2026-09-14 09:20", "2026-09-14 09:30", "2026-09-14 09:40", "2026-09-14 09:50"] }
