      "expected": { "quiet": ["atlas"], "at": "2026-09-14 09:50", "next": [{ "project": "beacon", "percent": 100 }] }
    },
    {
      "name": "a part without agent attention is never judged",
      "sessions": [
        {
          "id": "a",
          "repository": "atlas",
          "touches": ["2026-09-14 09:00", "2026-09-14 09:10", "2026-09-14 09:20", "2026-09-14 09:30", "2026-09-14 09:40", "2026-09-14 09:50", "2026-09-14 10:00", "2026-09-14 10:10", "2026-09-14 10:20"]
