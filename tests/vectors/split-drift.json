{
  "about": "When the work changes after a running entry was split (SplitDrift). The Mac's Kit (SplitDriftVectorTests.swift) and the Windows app (Spindle.Activity.Tests) both run these cases. Times are wall-clock times in timeZone; statedAt is when the entry's current split was set, and now is the moment it is checked. Projects and repositories are as in split-suggestions.json. expected is null when nothing changed; next is the split the new entry continues with.",
  "timeZone": "Europe/Zagreb",
  "projects": {
    "atlas": { "id": "0a000000-0000-4000-8000-000000000001", "name": "Atlas" },
    "beacon": { "id": "0a000000-0000-4000-8000-000000000002", "name": "Beacon" },
    "copper": { "id": "0a000000-0000-4000-8000-000000000003", "name": "Copper" }
  },
  "repositories": {
    "atlas": { "identity": "origin:github.com/acme/atlas", "name": "atlas" },
    "beacon": { "identity": "origin:gitlab.example.com/acme/beacon", "name": "beacon" },
    "copper": { "identity": "path:5f1c0e8d2a7b4c6e9f0a1b2c3d4e5f60", "name": "copper" },
    "zeta": { "identity": "origin:github.com/acme/zeta", "name": "zeta" }
  },
  "cases": [
    {
      "name": "a project whose agents went quiet ends the split where they stopped",
      "sessions": [
        { "id": "a", "repository": "atlas", "touches": ["2026-09-14 09:00", "2026-09-14 09:20"] },
        {
          "id": "b",
          "repository": "beacon",
          "touches": ["2026-09-14 09:10", "2026-09-14 09:30", "2026-09-14 09:40", "2026-09-14 09:50", "2026-09-14 10:00", "2026-09-14 10:10", "2026-09-14 10:20"]
        }
      ],
      "entry": {
        "start": "2026-09-14 09:00",
        "statedAt": "2026-09-14 09:00",
        "now": "2026-09-14 10:30",
        "parts": [{ "project": "atlas", "percent": 50 }, { "project": "beacon", "percent": 50 }]
      },
      "expected": { "quiet": ["atlas"], "at": "2026-09-14 09:30", "next": [{ "project": "beacon", "percent": 100 }] }
    },
    {
      "name": "a split just set is not judged before its own quiet window has passed",
      "sessions": [
        { "id": "a", "repository": "atlas", "touches": ["2026-09-14 09:00", "2026-09-14 09:20"] },
        {
          "id": "b",
          "repository": "beacon",
          "touches": ["2026-09-14 09:10", "2026-09-14 09:30", "2026-09-14 09:40", "2026-09-14 09:50", "2026-09-14 10:00", "2026-09-14 10:10", "2026-09-14 10:20"]
        }
      ],
      "entry": {
        "start": "2026-09-14 09:00",
        "statedAt": "2026-09-14 10:15",
        "now": "2026-09-14 10:30",
        "parts": [{ "project": "atlas", "percent": 50 }, { "project": "beacon", "percent": 50 }]
      },
      "expected": null
    },
    {
      "name": "the quiet window starts at the statement time",
      "sessions": [
        { "id": "a", "repository": "atlas", "touches": ["2026-09-14 09:00", "2026-09-14 09:20"] },
        {
          "id": "b",
          "repository": "beacon",
          "touches": ["2026-09-14 09:10", "2026-09-14 09:30", "2026-09-14 09:40", "2026-09-14 09:50", "2026-09-14 10:00", "2026-09-14 10:10", "2026-09-14 10:20"]
