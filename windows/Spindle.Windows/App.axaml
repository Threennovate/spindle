<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spindle.Windows.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the Windows light or dark setting. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Spindle/Theme/Tokens.axaml" />
                <ResourceInclude Source="avares://Spindle/Theme/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- The accent of checkboxes, switches and focus: a deeper amber that white text stays readable on, as on the Mac. -->
                <ColorPaletteResources x:Key="Light" Accent="#B07000" />
                <ColorPaletteResources x:Key="Dark" Accent="#C27C00" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Spindle/Theme/Controls.axaml" />
    </Application.Styles>
</Application>
